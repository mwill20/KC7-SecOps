{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kc7-secops:sources:v1",
  "title": "KC7 SecOps reference sources v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[GKP][0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "url": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000,
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
