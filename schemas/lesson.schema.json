{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kc7-secops:lesson:v1",
  "title": "KC7 SecOps lesson v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "enum": [
        "L01",
        "L02",
        "L03",
        "L04",
        "L05",
        "L06"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "level": {
      "enum": [
        "foundation",
        "developing",
        "intermediate",
        "capstone"
      ]
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 180
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "enum": [
          "L01",
          "L02",
          "L03",
          "L04",
          "L05",
          "L06"
        ]
      },
      "minItems": 0,
      "maxItems": 5
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "minItems": 3,
      "maxItems": 6
    },
    "story": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "teaching": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "heading",
          "text"
        ]
      },
      "minItems": 4,
      "maxItems": 8
    },
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^L0[1-6]-C0[12]$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "symbolIds": {
            "type": "array",
            "items": {
              "enum": [
                "USER",
                "HOST",
                "IP",
                "CIDR"
              ]
            },
            "minItems": 0,
            "maxItems": 4
          },
          "referenceQuery": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "acceptedVariants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "minItems": 1,
            "maxItems": 8
          },
          "hints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "minItems": 3,
            "maxItems": 3
          },
          "methodQuestions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "enum": [
                    "M1",
                    "M2"
                  ]
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "enum": [
                          "A",
                          "B",
                          "C"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "id",
                      "label"
                    ]
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "correctOption": {
                  "enum": [
                    "A",
                    "B",
                    "C"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1500
                }
              },
              "required": [
                "id",
                "prompt",
                "options",
                "correctOption",
                "rationale"
              ]
            },
            "minItems": 2,
            "maxItems": 2
          },
          "executeSteps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1500
            },
            "minItems": 3,
            "maxItems": 8
          },
          "debrief": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "title",
          "prompt",
          "symbolIds",
          "referenceQuery",
          "acceptedVariants",
          "hints",
          "methodQuestions",
          "executeSteps",
          "debrief"
        ]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[GKP][0-9]{2}$"
      },
      "minItems": 1,
      "maxItems": 12
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentationCheckedOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "tenantExecution": {
          "enum": [
            "not-tested",
            "user-pilot-only"
          ]
        }
      },
      "required": [
        "documentationCheckedOn",
        "tenantExecution"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "contentVersion",
    "id",
    "title",
    "level",
    "estimatedMinutes",
    "prerequisites",
    "objectives",
    "story",
    "teaching",
    "challenges",
    "sourceIds",
    "verification"
  ]
}
