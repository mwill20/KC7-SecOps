{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kc7-secops:symbols:v1",
  "title": "KC7 SecOps symbols v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "USER",
              "HOST",
              "IP",
              "CIDR"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "literal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "const": "string"
          },
          "privateInstruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "id",
          "label",
          "literal",
          "kind",
          "privateInstruction"
        ]
      },
      "minItems": 4,
      "maxItems": 4
    }
  },
  "required": [
    "schemaVersion",
    "symbols"
  ]
}
