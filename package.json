{
  "name": "kc7-secops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "validate:content": "node tools/validate-content.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "build": "node tools/build.mjs",
    "check:artifact": "node tools/check-artifact.mjs",
    "start": "node tools/serve.mjs",
    "test:browser": "playwright test",
    "verify": "npm run validate:content && npm test && npm run build && npm run check:artifact && npm run test:browser"
  },
  "devDependencies": { "@playwright/test": "1.64.1" }
}
